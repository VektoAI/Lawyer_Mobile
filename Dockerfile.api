# Mobile production API — auth, courts, cron. No PWA static files.
# Alias of ./Dockerfile (referenced by render.yaml → munshi-api).
FROM python:3.12-slim
WORKDIR /app
COPY backend/requirements.txt backend/requirements.txt
RUN pip install --no-cache-dir -r backend/requirements.txt
COPY backend backend
ENV PYTHONUNBUFFERED=1
ENV MUNSHI_SERVE_UI=0
EXPOSE 8080
CMD ["sh", "-c", "python -m uvicorn app.main:app --app-dir backend --host 0.0.0.0 --port ${PORT:-8080}"]
