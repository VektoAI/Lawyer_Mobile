# Auth / billing — never put case data credentials here.
# Copy to backend/.env locally; set the same vars on Render (munshi-api service). Never commit .env.

# ── Supabase (required) ──────────────────────────────────────────────────────
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_publishable_anon_key
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe (optional — billing webhooks) ─────────────────────────────────────
STRIPE_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=

# ── App mode ───────────────────────────────────────────────────────────────────
# Local dev: MUNSHI_DEMO=1  |  Render production: MUNSHI_DEMO=0
MUNSHI_DEMO=1
MUNSHI_SERVE_UI=0
MUNSHI_OPENAPI=1

# ── URLs ───────────────────────────────────────────────────────────────────────
# Local:
MUNSHI_FRONTEND_URL=http://127.0.0.1:4173
MUNSHI_CORS_ORIGINS=http://127.0.0.1:4173,http://localhost:4173
# Render production (munshi-api service):
# MUNSHI_FRONTEND_URL=https://munshi-api.onrender.com
# MUNSHI_CORS_ORIGINS=https://casevault-web.onrender.com,http://127.0.0.1:4173,http://localhost:4173

# Mobile email confirm deep link (must match Supabase redirect allow-list).
MUNSHI_MOBILE_AUTH_REDIRECT=casevault://auth/confirm

# ── Secrets (generate: python -c "import secrets;print(secrets.token_urlsafe(32))") ──
MUNSHI_ADMIN_TOKEN=
MUNSHI_CRON_SECRET=

# ── Data (optional — mount Render persistent disk at /data) ───────────────────
# MUNSHI_DATA_DIR=/data

# ── Supabase Dashboard → Authentication → URL Configuration ───────────────────
#   Site URL: https://munshi-api.onrender.com
#   Redirect URLs:
#     https://munshi-api.onrender.com/**
#     casevault://auth/confirm
#   Email template (Confirm signup):
#     {{ .SiteURL }}/api/auth/confirm?token_hash={{ .TokenHash }}&type=signup
